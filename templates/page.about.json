{"sections":{"main":{"type":"main-page","disabled":true,"settings":{"enable_animation":true,"content_width":"custom","custom_content_width":700}},"video_hero":{"type":"video-hero","blocks":{"accent_UNnEqh":{"type":"accent","disabled":true,"settings":{"accent":"Accent"}},"heading_FGFQwJ":{"type":"heading","settings":{"title":"About us","heading_tag":"h2","heading_font_class":"fs-heading-display-2"}},"play_button_3YjpDL":{"type":"play-button","disabled":true,"settings":{"video_source":"external","video_url":"https:\/\/www.youtube.com\/watch?v=_9VUPq3SxOc","aspect_ratio":"square","text":"Watch now","icon_style":"outline"}},"spacer_pnjNWe":{"type":"spacer","settings":{"space":24}}},"block_order":["accent_UNnEqh","heading_FGFQwJ","play_button_3YjpDL","spacer_pnjNWe"],"disabled":true,"settings":{"image_aspect":"custom","desktop_height":80,"mobile_height":50,"media_link":"","focal_point":"image_presentation","focal_point_mobile":"image_presentation","text_position":"flex-start_flex-end","text_position_mobile":"center_center","text_color":"#ffffff","button_background_color":"#ffffff","button_text_color":"#000000","color_overlay":"#000000","color_overlay_gradient":"","overlay_opacity":0,"enable_animation":true,"section_padding":"section--vertical-padding-none"}},"rich_text-1":{"type":"rich-text","blocks":{"spacer-1":{"type":"spacer","settings":{"space":40}},"heading":{"type":"heading","settings":{"title":"About Us","heading_tag":"h2","heading_font_class":"fs-heading-1-base"}},"spacer-2":{"type":"spacer","settings":{"space":12}},"text":{"type":"text","settings":{"text":"<p><strong>We Believe Every Scent Tells a Story<\/strong><\/p><p><em>My Scent Portfolio<\/em> is a curated fragrance destination - where iconic brands, timeless craftsmanship, and the art of scent come together in one beautifully considered space.<\/p><p>We bring you a handpicked collection of perfumes, colognes, candles, reed diffusers, and home fragrances from globally recognized names in fashion, lifestyle, and contemporary culture. Whether you're searching for a new signature scent, refreshing your space with ambient fragrance, or finding a gift that truly resonates - you'll find it here.<\/p><p><strong>A Portfolio Built with Purpose<\/strong><\/p><p>Every brand we carry has its own distinct identity, aesthetic, and story. Our collections span the full range of mood and moment - from the bold confidence of a fashion-house fragrance to the quiet warmth of a hand-poured candle. We've curated them together so exploring, discovering, and finding what speaks to you feels effortless.<\/p><p><strong>Fragrance Is Personal<\/strong><\/p><p>It's the scent you reach for on a good day. The candle that makes your home feel like yours. The gift someone actually remembers. We take the curation seriously - so you can shop with confidence and discover with joy.<\/p><p><strong>Every scent you love is here. Explore, discover, and build your Scent Portfolio.<\/strong><\/p>","text_font_class":"fs-body-100"}},"spacer-3":{"type":"spacer","settings":{"space":40}}},"block_order":["spacer-1","heading","spacer-2","text","spacer-3"],"custom_css":[],"settings":{"alignment":"left_left","enable_animation":true,"divider_style":"none","section_padding":"section--vertical-padding-top-bottom","content_width":"full","custom_content_width":700}},"multi_column_e3xHMT":{"type":"multi-column","blocks":{"icon_column_iCDU3t":{"type":"icon_column","settings":{"icon":"plant","icon_width":176,"icon_width_mobile":50,"custom_icon_image":"shopify:\/\/shop_images\/nautica_logo_39c8f344-b01a-4c0f-bf40-15ade01e9a99.png","accent":"","heading":"","heading_tag":"h3","heading_font_class":"fs-heading-4-base","text":"","text_font_class":"fs-body-100","text_max_width":100,"link":"shopify:\/\/collections\/nautica-home","link_text":"","button_style":"btn--primary"}},"icon_column_hcgBjb":{"type":"icon_column","settings":{"icon":"plant","icon_width":176,"icon_width_mobile":50,"custom_icon_image":"shopify:\/\/shop_images\/jc_logo_6083588a-681b-43a0-86b0-5f93759b8adb.png","accent":"","heading":"","heading_tag":"h3","heading_font_class":"fs-heading-4-base","text":"","text_font_class":"fs-body-100","text_max_width":100,"link":"shopify:\/\/collections\/juicy-couture","link_text":"","button_style":"btn--primary"}},"icon_column_mjn64H":{"type":"icon_column","settings":{"icon":"plant","icon_width":176,"icon_width_mobile":50,"custom_icon_image":"shopify:\/\/shop_images\/aeropostale_logo_ff3fda7c-bd8f-47a2-93cc-0cf24e420b26.png","accent":"","heading":"","heading_tag":"h3","heading_font_class":"fs-heading-4-base","text":"","text_font_class":"fs-body-100","text_max_width":100,"link":"shopify:\/\/collections\/aeropostale","link_text":"","button_style":"btn--primary"}},"icon_column_FENrXi":{"type":"icon_column","settings":{"icon":"plant","icon_width":176,"icon_width_mobile":50,"custom_icon_image":"shopify:\/\/shop_images\/f21_logo_f23cc3f8-6ae6-42ec-ac98-e406c2f12493.png","accent":"","heading":"","heading_tag":"h3","heading_font_class":"fs-heading-4-base","text":"","text_font_class":"fs-body-100","text_max_width":100,"link":"shopify:\/\/collections\/forever-21","link_text":"","button_style":"btn--primary"}}},"block_order":["icon_column_iCDU3t","icon_column_hcgBjb","icon_column_mjn64H","icon_column_FENrXi"],"name":"t:sections.multi_column.presets.name","settings":{"title":"","heading_tag":"h2","heading_font_class":"fs-heading-3-base","subheading":"","heading_alignment":"center","content_vertical_alignment":"center","content_background_padding":"medium","columns":"4","column_spacing":28,"row_spacing":28,"column_alignment":"center","enable_slider_mobile":false,"columns_mobile":"2","column_spacing_mobile":20,"row_spacing_mobile":20,"column_alignment_mobile":"center","background_behind_columns":false,"background_color":"","text_color":"#000000","button_background_color":"#000000","button_text_color":"#FFFFFF","enable_animation":true,"divider_style":"none","section_padding":"section--vertical-padding-top-bottom"}},"image_with_text_split":{"type":"image-with-text-split","blocks":{"heading":{"type":"heading","settings":{"title":"The Expertise Behind the Brand","heading_tag":"h2","heading_font_class":"fs-heading-1-base"}},"spacer":{"type":"spacer","settings":{"space":8}},"subheading":{"type":"subheading","disabled":true,"settings":{"subheading":"Use these sections to promote a particular feature with editorial photography.","subheading_tag":"h3","subheading_font_class":"fs-heading-6-base"}},"text":{"type":"text","settings":{"text":"<p><em>MY SCENT PORTFOLIO <\/em>is proudly operated by <a href=\"https:\/\/3binternational.com\">3B INTERNATIONAL<\/a>, a global fragrance and beauty company that creates, markets, and scales fragrance-led brands worldwide.<\/p><p>From private label development to licensing partnerships and global distribution, 3B International works with retailers, brand owners, and leading licensors to turn ideas into products people genuinely love - with speed, precision, and an obsessive commitment to quality.<\/p><p>That end-to-end expertise is what powers everything you find here: every bottle, every candle, every collection has been thoughtfully developed and delivered with care.<\/p><p><em>3B International — turning ideas into iconic fragrance and beauty brands.<\/em><\/p>","text_font_class":"fs-body-75"}}},"block_order":["heading","spacer","subheading","text"],"settings":{"image_position":"right","image_mobile_position":"above-content","image_padding":"none","image":"shopify:\/\/shop_images\/ABOUT_US.png","aspect_ratio":"natural","focal_point":"image_presentation","content_alignment":"left","background_color":"#c2d0f5","text_color":"#000000","button_background_color":"#000000","button_text_color":"#ffffff","enable_animation":true,"section_padding":"section--vertical-padding-none"}},"rich_text-2":{"type":"rich-text","blocks":{"spacer-1":{"type":"spacer","settings":{"space":40}},"heading":{"type":"heading","settings":{"title":"Fabrication & Sustainability","heading_tag":"h2","heading_font_class":"fs-heading-2-base"}},"spacer-2":{"type":"spacer","settings":{"space":20}},"text":{"type":"text","settings":{"text":"<p>We're committed to making cherished pieces that sustain a long lifetime in a women’s wardrobe. We firmly believe in our responsibility to minimise our impact on the planet & strive towards promoting sustainability.<br\/><br\/>To achieve this, we are dedicated to constantly innovating, evolving & adopting new sustainable practices in every aspect of our business. By remaining dynamic & constantly evolving, we endeavour to reduce our impact & foster a healthier, more sustainable future.<\/p>","text_font_class":"fs-body-100"}}},"block_order":["spacer-1","heading","spacer-2","text"],"disabled":true,"settings":{"alignment":"center_center","enable_animation":true,"divider_style":"none","section_padding":"section--vertical-padding-top-bottom","content_width":"custom","custom_content_width":850}},"gallery_carousel":{"type":"gallery-carousel","blocks":{"image-1":{"type":"image","settings":{"focal_point":"image_presentation","title":"Vegan Leather","text":"<p>Our luxurious PU leather is 100% vegan (not all faux leather is vegan) & not only feels oh so soft, but also (unlike leather) our PU doesn’t dry out over time. All our fabrications are kind to our furry friends, including our leather.<\/p>"}},"image-2":{"type":"image","settings":{"focal_point":"image_presentation","title":"Recycled Polyester","text":"<p>Recycled polyester, often called rPet, is made from recycled plastic bottles. It is a great way to divert plastic from our landfills. The production of recycled polyester requires far fewer resources than that of new fibres & generates fewer CO2 emissions. <\/p>"}},"image-3":{"type":"image","settings":{"focal_point":"image_presentation","title":"Textile Printing","text":"<p>All prints are created in house in Melbourne. The benefits of digitality printing include: no minimum order quantities, flexibility with colours\/complexity & cost-effectiveness due to no setup costs, therefore reducing the labour required to produce each print.<\/p>"}}},"block_order":["image-1","image-2","image-3"],"disabled":true,"settings":{"heading":"","heading_tag":"h2","subheading":"","link":"","link_text":"","button_style":"btn--callout","columns":"3","mobile_columns":"1","loop_carousel":true,"aspect_ratio":"square","image_caption_size":"fs-body-100","image_caption_style":"beneath","overlay_text_background_style":"gradient","overlay_text_color":"#ffffff","overlay_text_background":"#000000","enable_animation":true,"divider_style":"none","section_padding":"section--vertical-padding-top-bottom"}},"collapsible_row_list":{"type":"collapsible-row-list","blocks":{"item-1":{"type":"item","settings":{"expand_by_default":false,"icon":"leaf","title":"Low Waste","text":"<p>Overproduction in fashion is one of the world’s biggest environmental threats. To counter this issue, we have developed a close relation to our supplier, & adopted a bespoke arrangement which allows us to have no minimum quantities on orders. This allows us to produce small runs of inventory instead of mass bulk. This is to reduce waste & to ensure that our customers are repping unique styles.<br\/><\/p>"}},"item-2":{"type":"item","settings":{"expand_by_default":false,"icon":"t-shirt","title":"Worn For Good","text":"<p>We have teamed up with the wonderful women at Worn For Good to donate pieces. This is to ensure all our pieces & even samples get a happy home & therefore not contributing to waste & landfill, as well as donating to some incredible charities.<\/p>"}},"item-3":{"type":"item","settings":{"expand_by_default":false,"icon":"package-open","title":"Packaging","text":"<p>Our 100% recycled plastic dust bags will be equipped with a convenient drawstring closure. These dust bags are designed to be reusable, making them versatile for various purposes beyond just packaging fashion items. By opting for recycled plastic, we aim to minimise the demand for new plastic production and encourage the recycling of existing plastic materials.<\/p>"}}},"block_order":["item-1","item-2","item-3"],"disabled":true,"settings":{"title":"","heading_tag":"h2","heading_font_class":"fs-heading-3-base","heading_alignment":"left","subheading":"","subheading_tag":"h3","subheading_font_class":"fs-heading-5-base","item_heading_font":"heading","auto_collapse_rows":false,"enable_animation":true,"divider_style":"none","section_padding":"section--vertical-padding-top-bottom","content_width":"custom","custom_content_width":800}},"image_hero":{"type":"image-hero","disabled":true,"settings":{"image_aspect":"custom","desktop_height":80,"mobile_height":80,"focal_point":"image_presentation","mobile_focal_point":"image_presentation","media_link":"","text_position":"center_center","text_position_mobile":"center_center","text_color":"#ffffff","button_background_color":"#ffffff","button_text_color":"#000000","color_overlay":"#000000","color_overlay_gradient":"","overlay_opacity":20,"enable_animation":true,"section_padding":"section--vertical-padding-top-only"}},"multi_column_MJNp4M":{"type":"multi-column","blocks":{"column_FRbLHd":{"type":"column","settings":{"accent":"","heading":"30+ Years of Fragrance Experience","heading_tag":"h3","heading_font_class":"fs-heading-3-base","text":"","text_font_class":"fs-body-100","text_max_width":100,"link":"","link_text":"","button_style":"btn--primary"}},"column_wVMehJ":{"type":"column","settings":{"accent":"","heading":"25+ Brands Partnered With","heading_tag":"h3","heading_font_class":"fs-heading-3-base","text":"","text_font_class":"fs-body-100","text_max_width":100,"link":"","link_text":"","button_style":"btn--primary"}},"column_7TdjDW":{"type":"column","settings":{"accent":"","heading":"100+ Fragrance Collections Developed","heading_tag":"h3","heading_font_class":"fs-heading-3-base","text":"","text_font_class":"fs-body-100","text_max_width":100,"link":"","link_text":"","button_style":"btn--prima